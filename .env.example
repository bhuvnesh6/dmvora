# Flask
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
SESSION_COOKIE_SECURE=1
PORT=8822
DATA_DIR=/data
DATABASE_PATH=/data/dmvora.sqlite3
PUBLIC_BASE_URL=https://dmvora.sanjivanitechno.com

# Meta Embedded Signup — same Meta app used by PravahAI
META_APP_ID=2
META_APP_SECRET=REPLACE_WITH_REAL_META_APP_SECRET
META_ES_CONFIG_ID=18
META_ES_VERIFY_TOKEN=REPLACE_WITH_EXISTING_PRAVAH_VERIFY_TOKEN
META_GRAPH_VERSION=v25.0

# Internal PravahAI -> DMvora event forwarding
PRAVAH_WEBHOOK_SECRET=GENERATE_ONE_LONG_RANDOM_SHARED_SECRET
WEBHOOK_MAX_SKEW=300
